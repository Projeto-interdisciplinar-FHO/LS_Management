# Copie este arquivo para .env e preencha. O .env não vai para o git.
# Sem o .env, o Django cai no SQLite (backend/db.sqlite3) em vez do PostgreSQL.

DB_ENGINE=django.db.backends.postgresql
DB_NAME=ls_management
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Chave da API do Gemini usada por integrations/gemini_api (opcional).
API_KEY=
