{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Frontend: Vite dev server",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"run",
				"dev",
				"--",
				"--host",
				"127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Frontend: Install dependencies",
			"type": "shell",
			"command": "npm",
			"args": [
				"--prefix",
				"frontend",
				"ci"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Backend: Django dev server",
			"type": "shell",
			"command": ".venv\\Scripts\\python.exe",
			"args": [
				"backend\\manage.py",
				"runserver",
				"127.0.0.1:8000"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Backend: Install dependencies",
			"type": "shell",
			"command": ".venv\\Scripts\\python.exe",
			"args": [
				"-m",
				"pip",
				"install",
				"-r",
				"backend\\requirements.txt"
			],
			"isBackground": false,
			"problemMatcher": []
		},
	]
}